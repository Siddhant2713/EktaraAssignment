GEMINI_API_KEY=
# optional, defaults to gemini-3.1-flash-lite
GEMINI_MODEL=
# optional, the model that writes the openers (defaults to GEMINI_MODEL)
GEMINI_DRAFT_MODEL=
# optional, a second model to try when the main one is overloaded or out of quota.
# Worked on a free-tier key in testing: gemini-3.5-flash-lite  (gemini-2.5-flash-lite and gemini-2.5-flash did not)
GEMINI_FALLBACK_MODEL=
